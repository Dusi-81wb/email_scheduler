{
  "name": "outbox-backend",
  "version": "1.0.0",
  "description": "Production-grade cold email scheduler backend with BullMQ, Redis, PostgreSQL, and Elasticsearch",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node src/scripts/seed.ts",
    "test": "jest",
    "test:load": "ts-node src/scripts/test-load.ts",
    "test:restart": "ts-node src/scripts/test-restart.ts",
    "test:oauth": "ts-node src/scripts/test-oauth-flow.ts",
    "test:persistence": "ts-node src/scripts/test-persistence.ts"
  },
  "dependencies": {
    "@bull-board/api": "^5.14.0",
    "@bull-board/express": "^5.14.0",
    "@elastic/elasticsearch": "^8.12.0",
    "@prisma/client": "^5.11.0",
    "axios": "^1.6.8",
    "bullmq": "^5.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.13",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.11.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
