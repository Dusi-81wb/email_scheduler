# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://outbox_user:outbox_password@127.0.0.1:5432/outbox_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Concurrency & Rate Limiting Defaults
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
DEFAULT_HOURLY_LIMIT=100

# Slack Integration (Optional)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
SLACK_WEBHOOK_URL=

# Google OAuth (STRICTLY REQUIRED - No fake/dev login fallback)
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# JWT Secret for authenticating sessions
JWT_SECRET="outbox_super_secure_jwt_secret_key_2026"

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:3000
